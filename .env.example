# ==========================================================
# CampusEvent — Environment Variables Configuration
# Salin file ini menjadi .env pada environment lokal atau Vercel
# ==========================================================

# URL Proyek Supabase Anda (ditemukan di Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon Publik Supabase (Aman ditaruh di sisi frontend)
# JANGAN PERNAH menaruh service_role key di sini!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
